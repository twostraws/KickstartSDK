    },
    "This is a test advert, shown because the app is running from Xcode or the Simulator. It proves the Kickstart Exchange integration works, and no advertiser is charged for it. Real adverts appear once the app ships from the App Store." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a test advert, shown because the app is running from Xcode or the Simulator. It proves the Kickstart Exchange integration works, and no advertiser is charged for it. Real adverts appear once the app ships from the App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este anuncio de prueba se muestra porque la app se está ejecutando desde Xcode o el Simulador. Demuestra que la integración con Kickstart Exchange funciona y no se cobra a ningún anunciante. Los anuncios reales aparecerán cuando la app se publique en el App Store."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是測試廣告，因為此App正透過Xcode或模擬器執行而顯示。這表示Kickstart Exchange已成功整合，且不會向任何廣告主收費。正式廣告會在App透過App Store發佈後顯示。"
          }
        }
      }
    },
